{
  "project": "ForexTrade Technology – Multi-Theme Website",
  "version": "1.0",
  "description": "Global design system tokens, layout rules and component specifications that apply across all 6 themes and all 14 pages.",

  "style": {
    "overall_approach": "Modern fintech / B2B SaaS",
    "visual_language": "Clean, professional, trust-focused, modular",
    "border_radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "12px",
      "xl": "16px",
      "full": "9999px"
    },
    "shadows": {
      "card": "0 4px 20px rgba(0,0,0,0.06)",
      "card_hover": "0 12px 32px rgba(0,0,0,0.1)",
      "topbar": "0 1px 0 rgba(0,0,0,0.05)"
    },
    "transitions": {
      "default": "0.25s ease",
      "theme_switch": "0.3s ease",
      "hover": "0.2s ease"
    },
    "breakpoints": {
      "sm": "640px",
      "md": "768px",
      "lg": "1024px",
      "xl": "1280px",
      "2xl": "1400px"
    }
  },

  "tailwind": {
    "recommended": true,
    "version": "3.4+",
    "cdn": "https://cdn.tailwindcss.com",
    "config_notes": "Use Tailwind for utility classes. Theme-specific colors should be defined via CSS custom properties (CSS variables) so themes can be switched by changing body class.",
    "useful_utilities": [
      "container mx-auto px-6",
      "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6",
      "flex items-center justify-between",
      "sticky top-0 z-50",
      "rounded-xl",
      "transition-all duration-300",
      "shadow-sm hover:shadow-lg"
    ],
    "custom_config_suggestion": {
      "theme.extend.colors": "Map to CSS variables (e.g. primary: 'var(--accent)')",
      "theme.extend.fontFamily": "sans: ['Inter', 'system-ui', 'sans-serif']",
      "theme.extend.borderRadius": "Use the radius tokens above"
    }
  },

  "fonts": {
    "primary": {
      "family": "Inter",
      "weights": [300, 400, 500, 600, 700, 800],
      "fallback": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "google_fonts_url": "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
    },
    "theme_specific": {
      "current": "Inter",
      "matchtrade": "Outfit",
      "b2broker": "Space Grotesk",
      "leverate": "Poppins",
      "softfx": "Roboto",
      "uptrader": "Inter"
    },
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "line_height": {
      "tight": "1.25",
      "snug": "1.375",
      "normal": "1.5",
      "relaxed": "1.625"
    }
  },

  "colors": {
    "themes": {
      "current": {
        "name": "Current (forextrade.pincodeit.com)",
        "bg": "#ffffff",
        "section_alt": "#f7f9fc",
        "text": "#1a2332",
        "text_muted": "#5a6a7e",
        "heading": "#0f172a",
        "accent": "#2563eb",
        "accent_soft": "#eff6ff",
        "border": "#e2e8f0",
        "card_bg": "#ffffff",
        "topbar_bg": "rgba(255,255,255,0.92)",
        "cta_bg": "#1e3a8a",
        "cta_text": "#ffffff",
        "footer_bg": "#0f172a",
        "footer_text": "#e2e8f0"
      },
      "matchtrade": {
        "name": "Match-Trade",
        "bg": "#0b0e17",
        "section_alt": "#111622",
        "text": "#d1d5db",
        "text_muted": "#9ca3af",
        "heading": "#ffffff",
        "accent": "#7c3aed",
        "accent_soft": "rgba(124,58,237,0.15)",
        "border": "#1f2937",
        "card_bg": "#151a27",
        "topbar_bg": "rgba(11,14,23,0.95)",
        "cta_bg": "linear-gradient(135deg,#7c3aed,#4f46e5)",
        "cta_text": "#ffffff",
        "footer_bg": "#06080f",
        "footer_text": "#d1d5db"
      },
      "b2broker": {
        "name": "B2Broker",
        "bg": "#0a1628",
        "section_alt": "#0d1b2e",
        "text": "#c5d0de",
        "text_muted": "#8b9cb3",
        "heading": "#ffffff",
        "accent": "#f59e0b",
        "accent_soft": "rgba(245,158,11,0.12)",
        "border": "#1e3a5f",
        "card_bg": "#12233a",
        "topbar_bg": "rgba(10,22,40,0.95)",
        "cta_bg": "#f59e0b",
        "cta_text": "#0a1628",
        "footer_bg": "#060e1a",
        "footer_text": "#c5d0de"
      },
      "leverate": {
        "name": "Leverate",
        "bg": "#f8fafc",
        "section_alt": "#ffffff",
        "text": "#334155",
        "text_muted": "#64748b",
        "heading": "#0f172a",
        "accent": "#0ea5e9",
        "accent_soft": "#e0f2fe",
        "border": "#e2e8f0",
        "card_bg": "#ffffff",
        "topbar_bg": "rgba(255,255,255,0.95)",
        "cta_bg": "#0c4a6e",
        "cta_text": "#ffffff",
        "footer_bg": "#0f172a",
        "footer_text": "#e2e8f0"
      },
      "softfx": {
        "name": "Soft-FX",
        "bg": "#f4f6f8",
        "section_alt": "#ffffff",
        "text": "#2d3748",
        "text_muted": "#718096",
        "heading": "#1a202c",
        "accent": "#0d9488",
        "accent_soft": "#ccfbf1",
        "border": "#e2e8f0",
        "card_bg": "#ffffff",
        "topbar_bg": "rgba(255,255,255,0.96)",
        "cta_bg": "#134e4a",
        "cta_text": "#ffffff",
        "footer_bg": "#1a202c",

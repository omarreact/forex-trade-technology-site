        "text": "#1e293b",
        "text_muted": "#64748b",
        "heading": "#0f172a",
        "accent": "#3b82f6",
        "accent_soft": "#dbeafe",
        "border": "#e0e7ff",
        "card_bg": "#ffffff",
        "topbar_bg": "rgba(255,255,255,0.97)",
        "cta_bg": "linear-gradient(135deg,#2563eb,#3b82f6)",
        "cta_text": "#ffffff",
        "footer_bg": "#1e3a8a",
        "footer_text": "#e0e7ff"
      }
    },
    "semantic": {
      "success": "#10b981",
      "warning": "#f59e0b",
      "error": "#ef4444",
      "info": "#3b82f6"
    }
  },

  "spacing": {
    "margin": {
      "section_vertical": "80px",
      "section_vertical_mobile": "56px",
      "container_horizontal": "24px",
      "card_gap": "24px",
      "element_gap_sm": "8px",
      "element_gap_md": "16px",
      "element_gap_lg": "32px"
    },
    "padding": {
      "section": "80px 0",
      "section_mobile": "56px 0",
      "container": "0 24px",
      "card": "28px",
      "card_sm": "20px",
      "button": "12px 24px",
      "button_lg": "16px 32px",
      "topbar": "12px 20px",
      "input": "12px 16px"
    }
  },

  "dimensions": {
    "height": {
      "topbar": "64px",
      "button": "44px",
      "button_lg": "52px",
      "input": "48px",
      "logo_mark": "36px",
      "step_number": "40px",
      "hero_min": "420px"
    },
    "width": {
      "container_max": "1200px",
      "container_wide": "1400px",
      "content_max": "720px",
      "content_narrow": "600px",
      "card_min": "280px",
      "logo_mark": "36px"
    }
  },

  "navigation": {
    "type": "Sticky top navigation + theme switcher",
    "structure": {
      "left": "Logo (mark + text)",
      "center": "6 Theme buttons (desktop)",
      "right": "Mobile hamburger (mobile only)"
    },
    "theme_buttons": [
      { "id": "current", "label": "1. Current", "theme_class": "theme-current" },
      { "id": "matchtrade", "label": "2. Match-Trade", "theme_class": "theme-matchtrade" },
      { "id": "b2broker", "label": "3. B2Broker", "theme_class": "theme-b2broker" },
      { "id": "leverate", "label": "4. Leverate", "theme_class": "theme-leverate" },
      { "id": "softfx", "label": "5. Soft-FX", "theme_class": "theme-softfx" },
      { "id": "uptrader", "label": "6. UpTrader", "theme_class": "theme-uptrader" }
    ],
    "main_menu_links": [
      { "label": "Solutions", "href": "/#solutions" },
      { "label": "How It Works", "href": "/how-it-works/" },
      { "label": "About", "href": "/about-us/" },
      { "label": "FAQ", "href": "/faq/" },
      { "label": "Contact", "href": "/contact/" }
    ],
    "behavior": {
      "sticky": true,
      "backdrop_blur": true,
      "theme_switch": "Instant (body class change)",
      "persist_theme": "localStorage key: forex-theme",
      "keyboard_shortcuts": "Keys 1-6 switch themes",
      "mobile": "Hamburger opens vertical theme list"
    }
  },

  "header": {
    "component": "Topbar",
    "position": "sticky top-0 z-50",
    "height": "64px",
    "background": "var(--topbar-bg) with backdrop-filter: blur(12px)",
    "border_bottom": "1px solid var(--border)",
    "logo": {
      "mark": {
        "size": "36px",
        "border_radius": "8px",
        "background": "var(--accent)",
        "color": "#ffffff",
        "font_weight": 700,
        "text": "FT"
      },
      "text": {
        "font_weight": 700,
        "font_size": "1.05rem",
        "color": "var(--text)"
      }
    },
    "theme_button": {
      "font_size": "0.78rem",
      "font_weight": 600,
      "padding": "8px 12px",
      "border_radius": "8px",
      "border": "1px solid var(--border)",
      "active_state": "background: var(--accent); color: #fff"
    }
  },

  "footer": {
    "background": "var(--footer-bg)",
    "color": "var(--footer-text)",
    "padding": "60px 0 30px",
    "structure": {
      "columns": 3,
      "column_1": "Logo + short description",
      "column_2": "Solutions links (list)",
      "column_3": "Contact note"
    },
    "bottom": {
      "border_top": "1px solid rgba(255,255,255,0.1)",
      "risk_disclosure": {
        "font_size": "0.78rem",
        "opacity": 0.6
      },
      "copyright": {
        "font_size": "0.85rem",
        "opacity": 0.5
      }
    },
    "solutions_links": [
      "Brokerage Setup",
      "MT5 White Label",
      "Trading Server Hosting",
      "Liquidity & Connectivity",
      "Broker CRM & Back Office",
      "Prop Firm Technology"
    ]
  },

  "components": {
    "button_primary": {
      "padding": "12px 24px",
      "border_radius": "var(--radius)",
      "background": "var(--accent)",
      "color": "#ffffff",
      "font_weight": 600,
      "hover": "filter: brightness(1.1); transform: translateY(-1px)"
    },
    "button_secondary": {
      "padding": "12px 24px",
      "border_radius": "var(--radius)",
      "background": "transparent",
      "border": "2px solid var(--border)",
      "color": "var(--text)",
      "hover": "border-color: var(--accent); color: var(--accent)"
    },
    "card": {
      "background": "var(--card-bg)",
      "border": "1px solid var(--border)",
      "border_radius": "var(--radius)",
      "padding": "28px",
      "hover": "transform: translateY(-4px); box-shadow: var(--card-shadow)"
    },
    "section_header": {
      "text_align": "center",
      "max_width": "700px",
      "margin_bottom": "48px",
      "label": {
        "font_size": "0.75rem",
        "font_weight": 700,
        "letter_spacing": "0.08em",
        "text_transform": "uppercase",
        "color": "var(--accent)"
      }
    },
    "faq_item": {
      "background": "var(--card-bg)",
      "border": "1px solid var(--border)",
      "border_radius": "var(--radius)",
      "padding": "4px 20px"
    },
    "process_step": {
      "number_size": "40px",
      "number_background": "var(--accent)",
      "number_color": "#ffffff",
      "number_border_radius": "50%"
    }
  },

  "important_rules": [
    "All themes share the exact same HTML structure and content. Only CSS variables / body class change.",
    "Never hard-code colors in components. Always use CSS variables.",
    "Keep the topbar sticky on all pages.",
    "Risk disclosure must appear in the footer of every page.",
    "All pages must be fully responsive (mobile-first).",
    "Theme preference should be saved in localStorage.",
    "Use semantic HTML (section, article, nav, header, footer).",
    "Images (if any) must have alt text and be lazy-loaded.",
    "Forms must include proper labels and required field indicators.",
    "Maintain consistent vertical rhythm using the spacing tokens."
  ]
}
